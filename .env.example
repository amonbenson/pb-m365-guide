# PocketBase superuser, created or updated on every container start
PB_SUPERUSER_EMAIL=admin@example.com
PB_SUPERUSER_PASSWORD=replace-with-a-long-random-password

# Entra app registration (docs/02-entra-app-registration.md)
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=

# SharePoint site and list (docs/03-sharepoint.md)
# Site as <host>:/sites/<path>, for example contoso.sharepoint.com:/sites/demo
SHAREPOINT_SITE=contoso.sharepoint.com:/sites/demo
SHAREPOINT_LIST=Projects
# Person column used for the owner relation; defaults to the first editable Person column
SHAREPOINT_OWNER_COLUMN=Owner
